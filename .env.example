# Jornada do Brito — exemplo de ambiente
# Nunca versionar valores reais.

# Obrigatórias na hospedagem
JORNADA_BOOTSTRAP_TOKEN=
JORNADA_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Groq Free — IA principal
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=groq

# Reserva opcional; bloqueada para dados privados por padrão
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PRIVATE_DATA=false

# WhatsApp oficial — preencher somente após validar coexistência
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
